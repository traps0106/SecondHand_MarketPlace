# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
DB_NAME=marketplace

PORT=5000

# Origin allowed to call the API (the Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign JWTs. Required: 32+ random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Token lifetime (default 1h). Examples: 15m, 1h, 7d
JWT_EXPIRES_IN=1h

# Only for `npm run create-admin` (remove from your shell/.env afterwards)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=Administrator
